{#
    /**
    * @file
    * Gavias's theme implementation to display a single Drupal page.
    */
#}
<div class="login-body">
    <!-- Background -->
    <div class="background-container">
        <img src="/sites/default/files/bg/myworks-login.png" alt="City Background" class="background-img" />
        <div class="background-overlay"></div>
    </div>
    <!-- Toast Container -->
    <div id="toast-container"></div>
    <main class="login-card">
        <!-- Header -->
        <header class="card-header">
         {# {% if page.branding %}
            {{ page.branding }}
         {% endif %} #}
         <img src="/sites/default/files/logo-myworks-white.png" alt="MyWorks Logo" />
            <h1 class="header-title">
                MyWorks
            </h1>
            <h2 class="header-subtitle">
                {{ 'Kementerian Kerja Raya (KKR)' | t }}
            </h2>
        </header>
        <!-- Body -->
        <div class="card-body">
            {% if page.content %}
                <div class="content-main">
                    {{ page.content }}
                </div>
            {% endif %}
            <!-- Register -->
            <div class="register-text">
                {{ 'Telah reset kata laluan?'| t }}
                <a href="/user/login">
                    {{ 'Log masuk' | t }}
                </a>
            </div>
        </div>
        <!-- Footer -->
        <footer class="card-footer">
            <p class="copyright">
                &copy; 2026 MyWorks KKR. All rights reserved.
            </p>
        </footer>
    </main>
</div>