{#
/**
 * @file
 * Default template for Digital Clock block.
 *
 * Available variables:
 * - data: Array of clock configuration data.
 *   - container_backgraound_color: Background color for the container.
 *   - container_box_shadow_enable: Whether to enable box shadow.
 *   - container_box_shadow: Box shadow color.
 *   - time_color: Time text color.
 *   - date_color: Date text color.
 *   - description_color: Description text color.
 *   - time_text_shadow: Time text shadow color.
 *   - date_text_shadow: Date text shadow color.
 *   - description_text_shadow: Description text shadow color.
 *   - time_text_shadow_enable: Whether to enable time text shadow.
 *   - date_text_shadow_enable: Whether to enable date text shadow.
 *   - description_text_shadow_enable: Whether to enable description text shadow.
 *   - time_font_size: Font size for time.
 *   - date_font_size: Font size for date.
 *   - description_font_size: Font size for description.
 *   - timezone: Timezone identifier.
 *   - show_date: Whether to show the date.
 *   - current_date: Formatted current date.
 *   - description_text: Description text.
 *
 * @ingroup themeable
 */
#}
{% set container_style = 'background: ' ~ data.container_backgraound_color ~ ';' %}
{% set container_shadow = data.container_box_shadow_enable
    ? 'box-shadow: 0 1px 4px ' ~ data.container_box_shadow ~ ', 0 0 40px ' ~ data.container_box_shadow ~ ' inset, 0 15px 10px -10px ' ~ data.container_box_shadow ~ ', 0 1px 4px ' ~ data.container_box_shadow ~ ', 0 0 40px ' ~ data.container_box_shadow ~ ' inset;'
    : '' %}

{% set time_text_shadow = data.time_text_shadow_enable
    ? 'text-shadow: 0px 2px 25px ' ~ data.time_text_shadow ~ ';'
    : '' %}

{% set date_text_shadow = data.date_text_shadow_enable
    ? 'text-shadow: 0px 2px 25px ' ~ data.date_text_shadow ~ ';'
    : '' %}

{% set description_text_shadow = data.description_text_shadow_enable
    ? 'text-shadow: 0px 2px 25px ' ~ data.description_text_shadow ~ ';'
    : '' %}

{% set digitaltime_style = 'color: ' ~ data.time_color ~ ';' ~ time_text_shadow ~ 'font-size: ' ~ data.time_font_size ~ 'px;' %}
{% set date_style = 'color: ' ~ data.date_color ~ ';' ~ date_text_shadow ~ 'font-size: ' ~ data.date_font_size ~ 'px;' %}
{% set description_style = 'color: ' ~ data.description_color ~ ';' ~ description_text_shadow ~ 'font-size: ' ~ data.description_font_size ~ 'px;' %}

<div id="adc_block-screen" style="{{ container_style ~ container_shadow }}">
    <div id="adc_block-timezone">
        <p id="adc_block-digitaltime" class="adc_block-digitaltime" {% if data.timezone != '' %} data-timezone="{{ data.timezone }}" {% endif %} style="{{ digitaltime_style }}">00:00:00 PM</p>
        {% if data.show_date %}
            <p id="adc_block-date" style="{{ date_style }}">{{ data.current_date }}</p>
        {% endif %}
        {% if data.description_text != '' %}
            <p id="adc_block-description" style="{{ description_style }}">{{ data.description_text|raw }}</p>
        {% endif %}
    </div>
</div>
